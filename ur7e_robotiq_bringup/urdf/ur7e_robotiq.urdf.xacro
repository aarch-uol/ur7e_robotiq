<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur7e_robotiq">
  <!--
    Reuse the official UR driver description, including the UR ros2_control
    hardware interface. The arguments consumed by this file are intentionally
    the same arguments as ur_robot_driver/urdf/ur.urdf.xacro.
  -->
  <xacro:include filename="$(find ur_robot_driver)/urdf/ur.urdf.xacro"/>

  <!-- Visual/kinematic Robotiq model. Its ros2_control hardware is started by
       a separate controller_manager so a gripper communication failure cannot
       take down the UR arm controller. -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <!-- End-effector base (the locked hardware the GUI's parts go on top of). One environment variable selects it,
       and the SRDF and the launch files read the same one, so they always agree:
         ft_gripper  ATI Gamma + Robotiq 2F-85 (default, the setup described below)
         gripper     Robotiq 2F-85, its coupling straight on the flange (tool0)
         ft          ATI Gamma only: a tool of your own goes on ft_tool_mount_link (GUI parts)
         none        the bare arm -->
  <xacro:arg name="ee_config" default="$(optenv UR7E_EE_CONFIG ft_gripper)"/>
  <xacro:property name="ee" value="$(arg ee_config)"/>
  <xacro:if value="${ee not in ['none', 'gripper', 'ft', 'ft_gripper']}">
    ${xacro.fatal('UR7E_EE_CONFIG (ee_config) must be none, gripper, ft or ft_gripper, not ' + ee)}
  </xacro:if>
  <xacro:property name="has_ft" value="${ee in ['ft', 'ft_gripper']}"/>
  <xacro:property name="has_gripper" value="${ee in ['gripper', 'ft_gripper']}"/>
  <!-- UR7E_FT_BRIDGE=false (xacro arg ft_bridge): the Gamma is mounted (its links stay in the model) but its driver
       is not started, so leave out the TopicSensorBridge below: with no wrench topic it only reports stale samples.
       drivers.launch.py sets it from load_ft_sensor. -->
  <xacro:arg name="ft_bridge" default="$(optenv UR7E_FT_BRIDGE true)"/>
  <xacro:property name="ft_bridge" value="${str('$(arg ft_bridge)').lower() in ['true', '1']}"/>

  <!--
    Physical end-effector stack, along tool0 +Z:

      tool0
        -> 10 mm robot-side interface plate (still to be measured)
        -> 33.3 mm ATI Gamma DAQ/NET assembly
        -> 1 mm measured gap to the Robotiq coupling
        -> 16.9 mm Robotiq GRP-CPL-062 coupling
        -> Robotiq 2F-85

    ATI drawing 9230-05-1329 places the sensing reference origin 0.6 mm
    behind the tool-side interface face and defines +Z toward the tool side.
    Robotiq specifies the 2F-85 TCP at Z=174 mm from the coupling mounting
    reference with the coupling included.
  -->
  <xacro:property name="ati_robot_plate_thickness" value="0.010"/>
  <xacro:property name="ati_gamma_height" value="0.0333"/>
  <xacro:property name="ati_gamma_sensing_origin_z" value="0.0327"/>
  <xacro:property name="ati_gamma_tool_face_offset" value="0.0006"/>
  <xacro:property name="sensor_to_coupling_gap" value="0.001"/>
  <xacro:property name="robotiq_coupling_thickness" value="0.0169"/>
  <xacro:property name="ati_gamma_radius" value="0.0377"/>
  <xacro:property name="robotiq_coupling_radius" value="0.0375"/>
  <xacro:property name="robotiq_tcp_from_base" value="0.1571"/>

  <xacro:if value="${has_ft}">
  <!-- Robot-side plate. Link frames are placed on interface faces; geometry is
       offset by half its thickness so the fixed-joint dimensions stay obvious. -->
  <joint name="ati_robot_plate_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="ati_robot_plate_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="ati_robot_plate_link">
    <visual>
      <origin xyz="0 0 ${ati_robot_plate_thickness / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${ati_gamma_radius}" length="${ati_robot_plate_thickness}"/>
      </geometry>
      <material name="ati_adapter_grey">
        <color rgba="0.65 0.65 0.65 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${ati_robot_plate_thickness / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${ati_gamma_radius}" length="${ati_robot_plate_thickness}"/>
      </geometry>
    </collision>
  </link>

  <!-- ATI Gamma DAQ/NET assembly including its standard interface plates. -->
  <joint name="ati_gamma_body_joint" type="fixed">
    <parent link="ati_robot_plate_link"/>
    <child link="ati_gamma_body_link"/>
    <origin xyz="0 0 ${ati_robot_plate_thickness}" rpy="0 0 0"/>
  </joint>
  <link name="ati_gamma_body_link">
    <visual>
      <origin xyz="0 0 ${ati_gamma_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${ati_gamma_radius}" length="${ati_gamma_height}"/>
      </geometry>
      <material name="ati_gamma_teal">
        <color rgba="0.10 0.45 0.45 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${ati_gamma_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${ati_gamma_radius}" length="${ati_gamma_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${ati_gamma_height / 2.0}" rpy="0 0 0"/>
      <mass value="0.255"/>
      <inertia ixx="0.00011568" ixy="0" ixz="0"
               iyy="0.00011568" iyz="0" izz="0.00017930"/>
    </inertial>
  </link>

  <!-- ATI factory sensing frame. With the mounting side toward the robot,
       the drawing defines +Z toward the tool side. The installation assumes
       the Gamma +X mark is aligned with tool0 +X; verify only the remaining
       rotation about Z on the physical assembly.
       UR7E_FT_FRAME (xacro arg ft_frame, "x,y,z,roll,pitch,yaw" in mm and
       degrees, on ati_gamma_body_link) sets another pose: the launcher passes
       the one set in the GUI (SETUP > F/T + payload > Sensor frame). -->
  <xacro:arg name="ft_frame" default="$(optenv UR7E_FT_FRAME 0,0,${ati_gamma_sensing_origin_z * 1000.0},0,0,0)"/>
  <xacro:property name="ft_frame" value="${[float(v) for v in str('$(arg ft_frame)').split(',')]}"/>
  <xacro:if value="${len(ft_frame) != 6}">
    ${xacro.fatal('UR7E_FT_FRAME (ft_frame) must be x,y,z,roll,pitch,yaw (mm, degrees), not $(arg ft_frame)')}
  </xacro:if>
  <joint name="ft_fts_joint" type="fixed">
    <parent link="ati_gamma_body_link"/>
    <child link="ft_fts_link"/>
    <origin xyz="${ft_frame[0] / 1000.0} ${ft_frame[1] / 1000.0} ${ft_frame[2] / 1000.0}"
            rpy="${radians(ft_frame[3])} ${radians(ft_frame[4])} ${radians(ft_frame[5])}"/>
  </joint>
  <link name="ft_fts_link"/>

  <!-- The physical customer tool interface is 0.6 mm beyond ATI's sensing
       reference origin according to drawing 9230-05-1329. It hangs on the
       body, not on ft_fts_link, so another sensing frame leaves the tool where
       it is. -->
  <joint name="ft_tool_mount_joint" type="fixed">
    <parent link="ati_gamma_body_link"/>
    <child link="ft_tool_mount_link"/>
    <origin xyz="0 0 ${ati_gamma_sensing_origin_z + ati_gamma_tool_face_offset}" rpy="0 0 0"/>
  </joint>
  <link name="ft_tool_mount_link"/>
  <joint name="ati_sensor_alias_joint" type="fixed">
    <parent link="ft_fts_link"/>
    <child link="ati_sensor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="ati_sensor"/>
  </xacro:if>

  <xacro:if value="${has_gripper}">
  <!-- Measured physical spacing between the Gamma tool face and the front
       mounting face of the Robotiq coupling. There is no 10 mm adapter here. -->
  <xacro:if value="${has_ft}">
  <joint name="sensor_to_coupling_gap_joint" type="fixed">
    <parent link="ft_tool_mount_link"/>
    <child link="robotiq_coupling_mount_link"/>
    <origin xyz="0 0 ${sensor_to_coupling_gap}" rpy="0 0 0"/>
  </joint>
  </xacro:if>
  <!-- Without the ATI the GRP-CPL-062 coupling goes straight on the flange. -->
  <xacro:unless value="${has_ft}">
  <joint name="flange_to_coupling_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="robotiq_coupling_mount_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  </xacro:unless>
  <link name="robotiq_coupling_mount_link"/>

  <joint name="robotiq_coupling_joint" type="fixed">
    <parent link="robotiq_coupling_mount_link"/>
    <child link="robotiq_coupling_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="robotiq_coupling_link">
    <visual>
      <origin xyz="0 0 ${robotiq_coupling_thickness / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${robotiq_coupling_radius}" length="${robotiq_coupling_thickness}"/>
      </geometry>
      <material name="robotiq_coupling_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${robotiq_coupling_thickness / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${robotiq_coupling_radius}" length="${robotiq_coupling_thickness}"/>
      </geometry>
    </collision>
  </link>

  <joint name="robotiq_mount_joint" type="fixed">
    <parent link="robotiq_coupling_link"/>
    <child link="robotiq_mount_link"/>
    <origin xyz="0 0 ${robotiq_coupling_thickness}" rpy="0 0 0"/>
  </joint>
  <link name="robotiq_mount_link"/>

  <!-- The 2F-85 macro models +Z as its approach direction and +X as the
       finger-closing axis, matching tool0 in this installation. -->
  <xacro:robotiq_gripper
      name="robotiq_2f85"
      prefix=""
      parent="robotiq_mount_link"
      include_ros2_control="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- Robotiq specifies the 2F-85 TCP at Z=174.0 mm from the coupling
       mounting reference, coupling included. Since GRP-CPL-062 is 16.9 mm
       thick, the TCP is 157.1 mm beyond robotiq_85_base_link. -->
  <joint name="robotiq_tcp_joint" type="fixed">
    <parent link="robotiq_85_base_link"/>
    <child link="robotiq_tcp"/>
    <origin xyz="0 0 ${robotiq_tcp_from_base}" rpy="0 0 0"/>
  </joint>
  <link name="robotiq_tcp"/>
  </xacro:if>

  <!-- The physical Gamma is driven by the separate /ft controller manager.
       This read-only hardware component mirrors its WrenchStamped topic into
       the UR arm controller manager so admittance_controller can claim the
       ATI state interfaces without colliding with the UR driver's built-in
       tcp_fts_sensor. -->
  <xacro:if value="${has_ft and ft_bridge}">
  <ros2_control name="TopicSensorBridge" type="sensor">
    <hardware>
      <plugin>topic_sensor_bridge/TopicSensorHardware</plugin>
      <param name="sensor_name">ati_fts_sensor</param>
      <param name="topic_name">/ft/force_torque_sensor_broadcaster/wrench</param>
      <param name="force_bias_x">0.0</param>
      <param name="force_bias_y">0.0</param>
      <param name="force_bias_z">0.0</param>
      <param name="torque_bias_x">0.0</param>
      <param name="torque_bias_y">0.0</param>
      <param name="torque_bias_z">0.0</param>
      <param name="max_sample_age_sec">0.1</param>
    </hardware>
    <sensor name="ati_fts_sensor">
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
  </ros2_control>
  </xacro:if>

  <!-- Parts added in the MoveIt GUI (SETUP > Parts): a generated file of fixed links on this robot's links.
       The launcher sets UR7E_USER_PARTS_URDF to it when it exists; without it nothing changes. -->
  <xacro:arg name="user_parts_urdf" default="$(optenv UR7E_USER_PARTS_URDF none)"/>
  <xacro:if value="${'$(arg user_parts_urdf)' != 'none'}">
    <xacro:include filename="$(arg user_parts_urdf)"/>
  </xacro:if>
</robot>
