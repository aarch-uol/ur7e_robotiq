<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_2f85_control">
  <!-- Gripper-only description for /robotiq_controller_manager. The official
       UR tool-communication forwarder exposes the wrist RS485 bus at this
       local PTY; the stock Robotiq serial interface consumes it. -->
  <xacro:arg name="com_port" default="/tmp/ttyUR"/>
  <xacro:arg name="baudrate" default="115200"/>

  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <!-- This description is consumed only by the dedicated gripper
       controller_manager. It is not published to TF. -->
  <link name="robotiq_control_root"/>

  <xacro:robotiq_gripper
      name="robotiq_2f85"
      prefix=""
      parent="robotiq_control_root"
      include_ros2_control="true"
      com_port="$(arg com_port)"
      baudrate="$(arg baudrate)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>
</robot>
