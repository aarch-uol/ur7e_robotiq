<?xml version="1.0"?>
<package format="3">
  <name>ur7e_robotiq_moveit_config</name>
  <version>0.2.0</version>
  <description>MoveIt 2 configuration for the UR7e + Robotiq 2F-85 (arm and gripper groups).</description>
  <maintainer email="cenkcetix@gmail.com">cenk</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Also uses ur7e_robotiq_bringup's URDF. Not declared here because
       ur7e_robotiq_bringup depends on this package (moveit.launch.py). -->
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
