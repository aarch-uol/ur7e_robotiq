+    def _setup_fixed_bands(self):
+        self.fixed_bands = None
+        self.fixed_bands_only = bool(self.get_parameter("fixed_bands_only").value)
+        self.vial_cache_sec = float(self.get_parameter("vial_cache_sec").value)
+        self._vial = None
+        self._vial_lock = threading.Lock()
+        self._vial_busy = False
+        if self.fixed_bands_only:
+            self.get_logger().info(f'fixed_bands_only: no midpoint topics; vial box reused for {self.vial_cache_sec:.1f} s')
+        path = str(self.get_parameter("fixed_bands_robot_config").value or "").strip()
+        if not path:
+            self.get_logger().info('fixed_band_targets: off (no fixed_bands_robot_config)')
+            return
+        try:
+            cfg = fixed_bands.load_config(Path(path))
+            self.fixed_bands = fixed_bands.FixedBands(
+                cfg, latch_frames=int(self.get_parameter("fixed_bands_latch_frames").value))
+        except fixed_bands.FixedBandError as e:
+            self.get_logger().error(f'fixed_band_targets: off: {e}')
+            return
+        self.fixed_bands_stride = int(self.get_parameter("fixed_bands_stride").value)
+        self.fixed_bands_runner = str(self.get_parameter("fixed_bands_runner_node").value)
