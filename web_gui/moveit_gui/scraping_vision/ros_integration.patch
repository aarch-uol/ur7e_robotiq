+            f'  - {cfg.topic} (vial_bottom_z {cfg.vial_bottom_z:.4f} m, edges from {cfg.edges_from}, '
+            f'target z from {cfg.base_frame} <- {cfg.ee_frame})')
+
+    def _cached_vial(self, color_image):
+        """(yolo_rect, grabcut_mask) to reuse, or None to find the vial in this frame. An old one is still used
+        while a background thread finds the vial again, so a frame never waits for YOLO."""
+        with self._vial_lock:
+            v = self._vial
+            if v is None or self.vial_cache_sec <= 0:
+                return None
+            if time.monotonic() - v[2] > self.vial_cache_sec and not self._vial_busy:
+                self._vial_busy = True
+                threading.Thread(target=self._refresh_vial, args=(color_image.copy(),), daemon=True).start()
+            return v[0], v[1]
+
+    def _refresh_vial(self, color_image):
+        try:
+            d = detect_and_segment_vial(ImageData(color_image, None, "vial"))
+            if d.yolo_rect is not None and d.grabcut_mask is not None and np.count_nonzero(d.grabcut_mask):
+                self._keep_vial(d.yolo_rect, d.grabcut_mask)
+            else:
+                self.get_logger().warn('vial not found again: keeping the last vial box')
+                with self._vial_lock:
+                    self._vial = (self._vial[0], self._vial[1], time.monotonic())
+        except Exception as e:
+            self.get_logger().error(f'vial refresh: {e}')
+        finally:
+            with self._vial_lock:
+                self._vial_busy = False
+
+    def _keep_vial(self, rect, mask):
+        with self._vial_lock:
+            self._vial = (rect, mask, time.monotonic())
+
+    def _reset_fixed_bands(self, why):
+        if self.fixed_bands is not None:
+            self.fixed_bands.reset()
+            self.get_logger().info(f'fixed_band_targets: episode start ({why}): measuring the material again')
+
+    def _reset_fixed_bands_srv(self, _req, res):
+        self._reset_fixed_bands('reset_fixed_bands called')
+        res.success = True
+        res.message = 'material total is measured again over the next frames'
+        return res
+
+    def _watch_runner(self):
+        try:
+            names = self.get_node_names()
+        except Exception:
+            return
+        here = self.fixed_bands_runner in names
+        if here and not self._runner_seen:
+            self._reset_fixed_bands(f'{self.fixed_bands_runner} started')
+        self._runner_seen = here
+
+    def _lookup(self, target, source):
+        tf = self.tf_buffer.lookup_transform(target, source, Time(), timeout=Duration(seconds=0.05))
+        q, t = tf.transform.rotation, tf.transform.translation
+        return fixed_bands.quat_matrix(q.x, q.y, q.z, q.w), np.array([t.x, t.y, t.z])
+
+    def publish_fixed_bands(self, image_data, depth_image, camera_frame):
+        fb = self.fixed_bands
+        if fb is None or self.camera_matrix is None or image_data.contourmap is None:
+            return
+        rect = image_data.cropped_rect or image_data.yolo_rect
+        if rect is None:
+            return
+        source = self._resolve_camera_frame(camera_frame)
+        try:
+            R, t = self._lookup(fb.cfg.base_frame, source)
+            _, ee = self._lookup(fb.cfg.base_frame, fb.cfg.ee_frame)
+        except Exception as e:
+            self._warn_tf_failure(f'fixed_band_targets: {e}')
+            return
+        pts, area = fixed_bands.material_points(image_data.contourmap, depth_image, self.camera_matrix,
+                                                rect, self.fixed_bands_stride)
+        out = fb.compute(fixed_bands.to_frame(pts, R, t), area, float(ee[2]))
+        if out is None:
+            return
+        msg = Float32MultiArray()
+        msg.data = [float(v) for v in out]
+        msg.layout.dim = [MultiArrayDimension(label="occupancy_then_target_z", size=len(out), stride=1)]
+        self.fixed_bands_publisher.publish(msg)
 
