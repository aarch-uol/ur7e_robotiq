+def crop_rect(yolo_rect, shape, crop_percent=0.3, offset=-3):
+    """The evaluation crop of a YOLO rect (x, y, w, h): crop_percent off each side, the top 25% off."""
+    x, y, width, height = yolo_rect
+    crop_pixels = int(width * crop_percent)
+    vertical_crop_pixels = int(height * 0.25)
+    image_height, image_width = shape[:2]
+    x0 = max(0, min(x + crop_pixels + offset, image_width))
+    x1 = max(0, min(x + width - crop_pixels + offset, image_width))
+    y0 = max(0, min(y + vertical_crop_pixels, image_height))
+    y1 = max(0, min(y + height, image_height))
+    return (x0, y0, x1 - x0, y1 - y0)
+
