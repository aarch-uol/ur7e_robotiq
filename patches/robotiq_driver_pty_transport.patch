+// Copyright (c) 2026 Robotiq, Inc.
+//
+// Licensed under the BSD-3-Clause license; see LICENSE for details.
+
+//! \brief A Robotiq::Serial transport opened with plain POSIX open()/termios,
+//! bypassing libserialport.
+//!
+//! DefaultSerial (libserialport) refuses to open a pty: sp_get_port_by_name()
+//! rejects /dev/pts/* by device major, regardless of whether the path exists
+//! or is genuinely readable/writable — proven directly against libserialport
+//! 0.1.1 (sp_get_port_by_name succeeds on /dev/ttyS0, fails on /dev/pts/N).
+//! A pty is otherwise a perfectly ordinary POSIX character device, so plain
+//! open()/tcsetattr()/read()/write() works on it exactly as it would on a
+//! real /dev/ttyUSB0 — this class only skips libserialport's own port-name
+//! gatekeeping, not serial I/O.
+
+#pragma once
+
+#include <Robotiq/gripper/serial.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace robotiq_driver {
+
+class PosixSerial : public Robotiq::Serial
+{
+public:
+   PosixSerial(std::string path, uint32_t baudrate, std::chrono::milliseconds timeout);
+   ~PosixSerial() override;
+
+   PosixSerial(const PosixSerial&) = delete;
+   PosixSerial& operator=(const PosixSerial&) = delete;
+
+   //! \throw Robotiq::SerialIOException if the path cannot be opened or
+   //! configured, or if baudrate has no POSIX termios encoding.
+   void open() override;
+   [[nodiscard]] bool isOpen() const override;
+   void close() override;
+
+   //! \throw Robotiq::SerialIOException on a device-level read failure. A
+   //! plain timeout returns fewer bytes than requested (or none), matching
+   //! Serial::read's contract — it does not throw.
+   [[nodiscard]] std::vector<uint8_t> read(size_t size, std::chrono::milliseconds timeout) override;
+
+   //! \throw Robotiq::SerialIOException on a device-level write failure or a
+   //! write that does not complete within getTimeout().
+   void write(const std::vector<uint8_t>& data) override;
+
+   [[nodiscard]] std::chrono::milliseconds getTimeout() const override;
+
+private:
+   //! Reconnect if the link has dropped and the backoff has elapsed;
+   //! swallows a failed attempt (there is always another exchange cycle to
+   //! retry on) rather than throwing. Returns isOpen() after trying.
+   bool ensureOpen();
+
+   std::string path_;
+   uint32_t baudrate_;
+   std::chrono::milliseconds timeout_;
+   int fd_ = -1;
+   std::chrono::steady_clock::time_point next_reconnect_attempt_{};
+};
+
+} // namespace robotiq_driver
+
