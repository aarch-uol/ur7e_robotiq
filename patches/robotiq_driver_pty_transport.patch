diff --git a/grippers/robotiq_driver/src/posix_serial.cpp b/grippers/robotiq_driver/src/posix_serial.cpp
new file mode 100644
index 0000000..2d9e574
--- /dev/null
+++ b/grippers/robotiq_driver/src/posix_serial.cpp
@@ -0,0 +1,257 @@
+// Copyright (c) 2026 Robotiq, Inc.
+//
+// Licensed under the BSD-3-Clause license; see LICENSE for details.
+
+#include <robotiq_driver/posix_serial.hpp>
+
+#include <Robotiq/gripper/serial_io_exception.hpp>
+
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <termios.h>
+#include <unistd.h>
+
+namespace robotiq_driver {
+namespace {
+
+// The exchange thread calls read()/write() every cycle, so a dropped link
+// needs a floor on reconnect attempts rather than hammering open().
+constexpr std::chrono::milliseconds kReconnectBackoff{200};
+
+std::string describeErrno(int code)
+{
+   return std::strerror(code);
+}
+
+// termios speed_t has no numeric constructor from an arbitrary integer baud
+// rate; only the fixed B-constants it defines. The gripper only ever ships
+// at one of the standard rates below (115200 by default), so this is a
+// closed set, not a limitation in practice.
+speed_t termiosSpeed(uint32_t baudrate)
+{
+   switch(baudrate)
+   {
+   case 1200:
+      return B1200;
+   case 2400:
+      return B2400;
+   case 4800:
+      return B4800;
+   case 9600:
+      return B9600;
+   case 19200:
+      return B19200;
+   case 38400:
+      return B38400;
+   case 57600:
+      return B57600;
+   case 115200:
+      return B115200;
+   case 230400:
+      return B230400;
+   default:
+      throw Robotiq::SerialIOException(std::to_string(baudrate)
+                                       + " bps has no POSIX termios encoding (supported: 1200-230400 in the usual "
+                                         "steps)");
+   }
+}
+
+} // namespace
+
+PosixSerial::PosixSerial(std::string path, uint32_t baudrate, std::chrono::milliseconds timeout)
+   : path_(std::move(path))
+   , baudrate_(baudrate)
+   , timeout_(timeout)
+{
+}
+
+PosixSerial::~PosixSerial()
+{
+   PosixSerial::close();
+}
+
+void PosixSerial::open()
+{
+   if(fd_ >= 0)
+   {
+      return;
+   }
+   if(path_.empty())
+   {
+      throw Robotiq::SerialIOException("Cannot open serial port: path is empty");
+   }
+
+   // O_NONBLOCK on open() only: a pty's open() would otherwise block waiting
+   // for the peer (socat's `waitslave`) to be ready. Cleared right after, so
+   // the reads/writes below block normally and are paced by poll().
+   const int fd = ::open(path_.c_str(), O_RDWR | O_NOCTTY | O_NONBLOCK);
+   if(fd < 0)
+   {
+      throw Robotiq::SerialIOException("opening '" + path_ + "': " + describeErrno(errno));
+   }
+
+   const speed_t speed = termiosSpeed(baudrate_);
+
+   struct termios tio{};
+   if(::tcgetattr(fd, &tio) != 0)
+   {
+      const int savedErrno = errno;
+      ::close(fd);
+      throw Robotiq::SerialIOException("tcgetattr on '" + path_ + "': " + describeErrno(savedErrno));
+   }
+
+   ::cfmakeraw(&tio); // 8N1, no echo/signals/line-editing, no CR/LF translation.
+   ::cfsetispeed(&tio, speed);
+   ::cfsetospeed(&tio, speed);
+   tio.c_cflag |= CLOCAL | CREAD; // Ignore modem control lines; enable receiver.
+   // Reads below are timed with poll(), not termios VMIN/VTIME: return
+   // whatever is already buffered rather than block in read() itself.
+   tio.c_cc[VMIN] = 0;
+   tio.c_cc[VTIME] = 0;
+
+   if(::tcsetattr(fd, TCSANOW, &tio) != 0)
+   {
+      const int savedErrno = errno;
+      ::close(fd);
+      throw Robotiq::SerialIOException("tcsetattr on '" + path_ + "': " + describeErrno(savedErrno));
+   }
+
+   const int flags = ::fcntl(fd, F_GETFL, 0);
+   ::fcntl(fd, F_SETFL, flags & ~O_NONBLOCK);
+
+   fd_ = fd;
+}
+
+bool PosixSerial::isOpen() const
+{
+   return fd_ >= 0;
+}
+
+bool PosixSerial::ensureOpen()
+{
+   if(fd_ >= 0)
+   {
+      return true;
+   }
+   if(std::chrono::steady_clock::now() < next_reconnect_attempt_)
+   {
+      return false;
+   }
+   next_reconnect_attempt_ = std::chrono::steady_clock::now() + kReconnectBackoff;
+   try
+   {
+      open();
+   }
+   catch(const Robotiq::SerialIOException&)
+   {
+      // Swallowed: the exchange loop will retry after the backoff.
+   }
+   return fd_ >= 0;
+}
+
+void PosixSerial::close()
+{
+   if(fd_ >= 0)
+   {
+      ::close(fd_);
+      fd_ = -1;
+   }
+}
+
+std::vector<uint8_t> PosixSerial::read(size_t size, std::chrono::milliseconds timeout)
+{
+   if(!ensureOpen())
+   {
+      // Between reconnect attempts: the SDK's own timeout/retry policy
+      // already tolerates this exactly like a device that hasn't answered
+      // yet, so it needs no exception — just nothing to read this cycle.
+      return {};
+   }
+
+   struct pollfd pfd{};
+   pfd.fd = fd_;
+   pfd.events = POLLIN;
+   const int pollResult = ::poll(&pfd, 1, static_cast<int>(timeout.count()));
+   if(pollResult == 0)
+   {
+      return {}; // Nothing arrived within the timeout — not an error.
+   }
+   if(pollResult < 0)
+   {
+      throw Robotiq::SerialIOException("polling '" + path_ + "' for read: " + describeErrno(errno));
+   }
+   if((pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0)
+   {
+      close(); // So the next call reconnects instead of repeating this.
+      throw Robotiq::SerialIOException("'" + path_ + "' closed while waiting to read");
+   }
+
+   std::vector<uint8_t> data(size);
+   const ssize_t received = ::read(fd_, data.data(), size);
+   if(received < 0)
+   {
+      close();
+      throw Robotiq::SerialIOException("reading from '" + path_ + "': " + describeErrno(errno));
+   }
+   data.resize(static_cast<size_t>(received));
+   return data;
+}
+
+void PosixSerial::write(const std::vector<uint8_t>& data)
+{
+   if(!ensureOpen())
+   {
+      throw Robotiq::SerialIOException("write called while reconnecting");
+   }
+
+   const auto deadline = std::chrono::steady_clock::now() + timeout_;
+   size_t sent = 0;
+   while(sent < data.size())
+   {
+      const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now());
+      if(remaining.count() <= 0)
+      {
+         throw Robotiq::SerialIOException("write timeout: wrote " + std::to_string(sent) + " of "
+                                          + std::to_string(data.size()) + " bytes");
+      }
+
+      struct pollfd pfd{};
+      pfd.fd = fd_;
+      pfd.events = POLLOUT;
+      const int pollResult = ::poll(&pfd, 1, static_cast<int>(remaining.count()));
+      if(pollResult == 0)
+      {
+         throw Robotiq::SerialIOException("write timeout: wrote " + std::to_string(sent) + " of "
+                                          + std::to_string(data.size()) + " bytes");
+      }
+      if(pollResult < 0)
+      {
+         throw Robotiq::SerialIOException("polling '" + path_ + "' for write: " + describeErrno(errno));
+      }
+      if((pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0)
+      {
+         close();
+         throw Robotiq::SerialIOException("'" + path_ + "' closed while writing");
+      }
+
+      const ssize_t written = ::write(fd_, data.data() + sent, data.size() - sent);
+      if(written < 0)
+      {
+         close();
+         throw Robotiq::SerialIOException("writing to '" + path_ + "': " + describeErrno(errno));
+      }
+      sent += static_cast<size_t>(written);
+   }
+}
+
+std::chrono::milliseconds PosixSerial::getTimeout() const
+{
+   return timeout_;
+}
+
+} // namespace robotiq_driver
+

