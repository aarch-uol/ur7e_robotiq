+// Copy of the SDK's private Robotiq::detail::exchangePeriodFromFrequency,
+// which is not in its installed headers.
+std::chrono::microseconds exchangePeriodFromFrequency(double hz)
+{
+   if(hz == 0.0)
+   {
+      return std::chrono::microseconds{0};
+   }
+   const double supported = std::clamp(hz, 0.1, 1000.0);
+   return std::chrono::microseconds{std::llround(1000000.0 / supported)};
+}
