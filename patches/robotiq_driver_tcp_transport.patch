+// Copyright (c) 2026 cenk <cenkcetix@gmail.com>
+//
+// Licensed under the BSD-3-Clause license; see LICENSE for details.
+
+//! \brief A Robotiq::Serial transport over a raw TCP socket, for a gripper
+//! behind an RS-485-over-TCP bridge such as the UR wrist tool port.
+//!
+//! The bridge may drop the connection at any time; the next read()/write()
+//! reconnects automatically.
+
+#pragma once
+
+#include <Robotiq/gripper/serial.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace robotiq_driver {
+
+class TcpSerial : public Robotiq::Serial
+{
+public:
+   TcpSerial(std::string host, uint16_t port, std::chrono::milliseconds timeout);
+   ~TcpSerial() override;
+
+   TcpSerial(const TcpSerial&) = delete;
+   TcpSerial& operator=(const TcpSerial&) = delete;
+
+   //! \throw Robotiq::SerialIOException on a resolve/connect failure.
+   void open() override;
+   [[nodiscard]] bool isOpen() const override;
+   void close() override;
+
+   //! Waits until \p size bytes arrived or \p timeout expired.
+   //! \throw Robotiq::SerialIOException if the connection fails.
+   [[nodiscard]] std::vector<uint8_t> read(size_t size, std::chrono::milliseconds timeout) override;
+
+   //! \throw Robotiq::SerialIOException if the connection fails or the write
+   //! does not complete within getTimeout().
+   void write(const std::vector<uint8_t>& data) override;
+
+   [[nodiscard]] std::chrono::milliseconds getTimeout() const override;
+
+private:
+   //! Reconnects if the link is down, at most once per backoff period.
+   bool ensureOpen();
+
+   std::string host_;
+   uint16_t port_;
+   std::chrono::milliseconds timeout_;
+   int fd_ = -1;
+   std::chrono::steady_clock::time_point next_reconnect_attempt_{};
+};
+
+} // namespace robotiq_driver
