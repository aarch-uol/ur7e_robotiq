diff --git a/grippers/robotiq_driver/src/tcp_serial.cpp b/grippers/robotiq_driver/src/tcp_serial.cpp
new file mode 100644
index 0000000..c217779
--- /dev/null
+++ b/grippers/robotiq_driver/src/tcp_serial.cpp
@@ -0,0 +1,281 @@
+// Copyright (c) 2026 cenk <cenkcetix@gmail.com>
+//
+// Licensed under the BSD-3-Clause license; see LICENSE for details.
+
+#include <robotiq_driver/tcp_serial.hpp>
+
+#include <Robotiq/gripper/serial_io_exception.hpp>
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace robotiq_driver {
+namespace {
+
+using std::chrono::milliseconds;
+using std::chrono::steady_clock;
+
+constexpr milliseconds kConnectTimeout{1000};
+
+// read()/write() run every exchange cycle (10 ms by default); don't retry
+// connect() that often while the bridge is down.
+constexpr milliseconds kReconnectBackoff{200};
+
+std::string describeErrno(int code)
+{
+   return std::strerror(code);
+}
+
+void setNonBlocking(int fd, bool nonBlocking)
+{
+   const int flags = ::fcntl(fd, F_GETFL, 0);
+   ::fcntl(fd, F_SETFL, nonBlocking ? (flags | O_NONBLOCK) : (flags & ~O_NONBLOCK));
+}
+
+int remainingMs(steady_clock::time_point deadline)
+{
+   const auto remaining = std::chrono::duration_cast<milliseconds>(deadline - steady_clock::now()).count();
+   return static_cast<int>(std::max<decltype(remaining)>(remaining, 0));
+}
+
+} // namespace
+
+TcpSerial::TcpSerial(std::string host, uint16_t port, milliseconds timeout)
+   : host_(std::move(host))
+   , port_(port)
+   , timeout_(timeout)
+{
+}
+
+TcpSerial::~TcpSerial()
+{
+   TcpSerial::close();
+}
+
+void TcpSerial::open()
+{
+   if(fd_ >= 0)
+   {
+      return;
+   }
+   if(host_.empty() || port_ == 0)
+   {
+      throw Robotiq::SerialIOException("Cannot open TCP serial bridge: host or port is empty");
+   }
+
+   struct addrinfo hints{};
+   hints.ai_family = AF_UNSPEC;
+   hints.ai_socktype = SOCK_STREAM;
+   struct addrinfo* resolved = nullptr;
+   const int gaiResult = ::getaddrinfo(host_.c_str(), std::to_string(port_).c_str(), &hints, &resolved);
+   if(gaiResult != 0)
+   {
+      throw Robotiq::SerialIOException("resolving " + host_ + ": " + gai_strerror(gaiResult));
+   }
+
+   int fd = -1;
+   int lastErrno = 0;
+   for(const struct addrinfo* candidate = resolved; candidate != nullptr; candidate = candidate->ai_next)
+   {
+      fd = ::socket(candidate->ai_family, candidate->ai_socktype, candidate->ai_protocol);
+      if(fd < 0)
+      {
+         lastErrno = errno;
+         continue;
+      }
+
+      // Non-blocking connect so an unreachable host can't hang for the OS
+      // default (minutes).
+      setNonBlocking(fd, true);
+      if(::connect(fd, candidate->ai_addr, candidate->ai_addrlen) == 0)
+      {
+         break;
+      }
+      if(errno == EINPROGRESS)
+      {
+         struct pollfd pfd{fd, POLLOUT, 0};
+         const int pollResult = ::poll(&pfd, 1, static_cast<int>(kConnectTimeout.count()));
+         int socketError = pollResult == 0 ? ETIMEDOUT : errno;
+         if(pollResult > 0)
+         {
+            socklen_t errorLen = sizeof(socketError);
+            ::getsockopt(fd, SOL_SOCKET, SO_ERROR, &socketError, &errorLen);
+         }
+         if(socketError == 0)
+         {
+            break;
+         }
+         lastErrno = socketError;
+      }
+      else
+      {
+         lastErrno = errno;
+      }
+      ::close(fd);
+      fd = -1;
+   }
+   ::freeaddrinfo(resolved);
+
+   if(fd < 0)
+   {
+      throw Robotiq::SerialIOException("connecting to " + host_ + ":" + std::to_string(port_) + ": "
+                                       + describeErrno(lastErrno));
+   }
+
+   setNonBlocking(fd, false);
+   // Modbus frames are tiny; don't let Nagle hold them back.
+   constexpr int enable = 1;
+   ::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &enable, sizeof(enable));
+
+   fd_ = fd;
+}
+
+bool TcpSerial::isOpen() const
+{
+   return fd_ >= 0;
+}
+
+bool TcpSerial::ensureOpen()
+{
+   if(fd_ >= 0)
+   {
+      return true;
+   }
+   if(steady_clock::now() < next_reconnect_attempt_)
+   {
+      return false;
+   }
+   next_reconnect_attempt_ = steady_clock::now() + kReconnectBackoff;
+   try
+   {
+      open();
+   }
+   catch(const Robotiq::SerialIOException&)
+   {
+      // Retried on a later cycle; the SDK reports the resulting link fault.
+   }
+   return fd_ >= 0;
+}
+
+void TcpSerial::close()
+{
+   if(fd_ >= 0)
+   {
+      ::close(fd_);
+      fd_ = -1;
+   }
+}
+
+std::vector<uint8_t> TcpSerial::read(size_t size, milliseconds timeout)
+{
+   if(!ensureOpen())
+   {
+      return {}; // Seen by the SDK as a missing reply.
+   }
+
+   // Like sp_blocking_read: nanomodbus treats a short read as a timeout, so
+   // collect all `size` bytes even if they arrive in several TCP segments.
+   // A zero timeout only drains what is already buffered.
+   std::vector<uint8_t> data(size);
+   size_t received = 0;
+   const auto deadline = steady_clock::now() + timeout;
+   while(received < size)
+   {
+      struct pollfd pfd{fd_, POLLIN, 0};
+      const int pollResult = ::poll(&pfd, 1, remainingMs(deadline));
+      if(pollResult == 0)
+      {
+         break;
+      }
+      if(pollResult < 0)
+      {
+         if(errno == EINTR)
+         {
+            continue;
+         }
+         throw Robotiq::SerialIOException("polling TCP serial bridge for read: " + describeErrno(errno));
+      }
+
+      const ssize_t count = ::recv(fd_, data.data() + received, size - received, 0);
+      if(count == 0)
+      {
+         close(); // The next call reconnects.
+         throw Robotiq::SerialIOException("TCP serial bridge closed the connection");
+      }
+      if(count < 0)
+      {
+         if(errno == EINTR)
+         {
+            continue;
+         }
+         const int savedErrno = errno;
+         close();
+         throw Robotiq::SerialIOException("reading from TCP serial bridge: " + describeErrno(savedErrno));
+      }
+      received += static_cast<size_t>(count);
+   }
+   data.resize(received);
+   return data;
+}
+
+void TcpSerial::write(const std::vector<uint8_t>& data)
+{
+   if(!ensureOpen())
+   {
+      // Drop the request instead of throwing: this runs every exchange cycle
+      // while reconnecting, and the SDK already reports the missing reply.
+      return;
+   }
+
+   const auto deadline = steady_clock::now() + timeout_;
+   size_t sent = 0;
+   while(sent < data.size())
+   {
+      struct pollfd pfd{fd_, POLLOUT, 0};
+      const int pollResult = ::poll(&pfd, 1, remainingMs(deadline));
+      if(pollResult == 0)
+      {
+         throw Robotiq::SerialIOException("write timeout: wrote " + std::to_string(sent) + " of "
+                                          + std::to_string(data.size()) + " bytes");
+      }
+      if(pollResult < 0)
+      {
+         if(errno == EINTR)
+         {
+            continue;
+         }
+         throw Robotiq::SerialIOException("polling TCP serial bridge for write: " + describeErrno(errno));
+      }
+
+      // MSG_NOSIGNAL: a closed peer returns EPIPE instead of killing the process.
+      const ssize_t count = ::send(fd_, data.data() + sent, data.size() - sent, MSG_NOSIGNAL);
+      if(count < 0)
+      {
+         if(errno == EINTR)
+         {
+            continue;
+         }
+         const int savedErrno = errno;
+         close(); // The next call reconnects.
+         throw Robotiq::SerialIOException("writing to TCP serial bridge: " + describeErrno(savedErrno));
+      }
+      sent += static_cast<size_t>(count);
+   }
+}
+
+milliseconds TcpSerial::getTimeout() const
+{
+   return timeout_;
+}
+
+} // namespace robotiq_driver
